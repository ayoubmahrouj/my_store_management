# =========================================================================
# Gestion Our Stock — configuration Apache (racine de l'application)
# =========================================================================

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dossiers internes : jamais accessibles par URL
    RewriteRule ^(shared|database|storage)(/|$) - [F,L,NC]

    # Fichiers de travail / sauvegardes
    RewriteRule \.(sql|log|bak|old|zip|tar|gz|ini|env)$ - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Front controller du module Stock (URLs sans .php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^modules/stock(/.*)?$ modules/stock/index.php [QSA,L]
</IfModule>

# Fichiers cachés
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Configuration et sauvegardes
<FilesMatch "\.(sql|log|ini|env|bak|old|zip|tar|gz)$">
    Require all denied
</FilesMatch>

# Fichiers sensibles
<Files "config.local.php">
    Require all denied
</Files>
<Files "router.php">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>

# =========================================================================
# Compression (mod_deflate) — pages HTML/JSON fortement réduites sur le réseau
# =========================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml

    # Ne jamais recompresser ce qui est déjà compressé (images, archives, polices)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|rar|7z|woff2?|ttf|eot|mp4|pdf)$ no-gzip dont-vary
</IfModule>

# =========================================================================
# Cache navigateur — uniquement les ressources rarement modifiées
# (les CSS/JS ne sont pas mis en cache longtemps pour éviter les versions périmées)
# =========================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 365 days"
    ExpiresByType application/font-woff2 "access plus 365 days"
</IfModule>
