# Exemple de virtual host Nginx pour Suivi Stock.
# Adapter server_name, root et le socket PHP-FPM à votre serveur.
#
# Important : Nginx ne lit pas .htaccess. Ce fichier doit être installé
# dans /etc/nginx/sites-available/ puis activé avec un lien symbolique.

server {
    listen 80;
    server_name stock.example.com;

    root /var/www/suivi-stock;
    index index.php;

    # Dossiers et fichiers sensibles : jamais accessibles depuis le web.
    location ~ ^/(app|config|database|docs|storage)(/|$) {
        deny all;
        return 404;
    }

    location ~ /\. {
        deny all;
        return 404;
    }

    location ~* \.(sql|log|env|md|bak|ini)$ {
        deny all;
        return 404;
    }

    # Assets statiques servis directement.
    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Front controller MVC / API.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    # En-têtes de sécurité.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # À activer uniquement après installation du certificat HTTPS.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
}
